# Postgres (Neon). Prisma reads this for db:push, studio and runtime queries.
DATABASE_URL=

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Shared secret for the Make.com Meta scenario (POST /api/webhooks/meta).
META_WEBHOOK_SECRET=

# Google Sheets (vendas)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Shared secret for the manual sync endpoints (POST /api/sync/sheets).
SYNC_SECRET=

# Shared secret for the Make.com Instagram scenario (POST /api/webhooks/instagram).
# Without it the route answers 401 to everything.
INSTAGRAM_WEBHOOK_SECRET=

# Optional. Overrides the "daily collection started on" date shown on /social.
SOCIAL_START_DATE=
