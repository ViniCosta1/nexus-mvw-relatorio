generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id             String   @id @default(cuid())
  metaCampaignId String   @unique @map("meta_campaign_id")
  name           String
  objective      String?
  // No status column on purpose: the Make scenario sends insights only, never
  // Meta's effective_status, so a stored value would be a default masquerading
  // as fact. Delivery state is derived from the insights (see deliveryStatus).
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ads   Ad[]
  sales Sale[]

  @@map("campaigns")
}

model Ad {
  id           String   @id @default(cuid())
  metaAdId     String   @unique @map("meta_ad_id")
  name         String
  adsetId      String?  @map("adset_id")
  adsetName    String?  @map("adset_name")
  campaignId   String   @map("campaign_id")
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  // Creative preview, populated from Make/Meta when available. Nullable: many
  // pipelines only send insights, so the dialog falls back to a placeholder.
  creativeType String?  @map("creative_type") // IMAGE | VIDEO | ...
  thumbnailUrl String?  @map("thumbnail_url")
  imageUrl     String?  @map("image_url")
  permalinkUrl String?  @map("permalink_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  insights AdInsightDaily[]

  @@index([campaignId])
  @@map("ads")
}

model AdInsightDaily {
  id          String   @id @default(cuid())
  adId        String   @map("ad_id")
  ad          Ad       @relation(fields: [adId], references: [id])
  date        DateTime @db.Date
  spend       Decimal  @db.Decimal(12, 2)
  impressions Int
  clicks      Int
  reach       Int
  frequency   Decimal  @db.Decimal(10, 4)
  ctr         Decimal  @db.Decimal(6, 4)
  cpc         Decimal  @db.Decimal(10, 4)
  cpm         Decimal  @db.Decimal(10, 4)
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@unique([adId, date])
  @@index([date])
  @@map("ad_insights_daily")
}

model Sale {
  id          String    @id @default(cuid())
  externalId  String    @unique @map("external_id")
  clientName  String    @map("client_name")
  clientEmail String?   @map("client_email")
  clientPhone String?   @map("client_phone")
  sellerName  String    @map("seller_name")
  productName String    @map("product_name")
  amount      Decimal   @db.Decimal(12, 2)
  saleDate    DateTime  @db.Date @map("sale_date")
  utmSource   String?   @map("utm_source")
  utmMedium   String?   @map("utm_medium")
  utmCampaign String?   @map("utm_campaign")
  utmContent  String?   @map("utm_content")
  channel     String
  campaignId  String?   @map("campaign_id")
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  rawRow      Json      @map("raw_row")
  syncedAt    DateTime  @default(now()) @map("synced_at")

  @@index([saleDate])
  @@index([campaignId, saleDate])
  @@index([sellerName])
  @@map("sales")
}

enum SyncSource {
  META
  SHEETS
  INSTAGRAM
}

enum SyncStatus {
  SUCCESS
  ERROR
  RUNNING
}

model SyncRun {
  id            String     @id @default(cuid())
  source        SyncSource
  startedAt     DateTime   @default(now()) @map("started_at")
  finishedAt    DateTime?  @map("finished_at")
  status        SyncStatus
  rowsProcessed Int        @default(0) @map("rows_processed")
  errorMessage  String?    @map("error_message")

  @@map("sync_runs")
}

// One row per Instagram profile per calendar day, pushed by a Make scenario.
// Independent of Campaign/Sale on purpose: nothing attributes organic Instagram
// activity to an ad campaign or a ticket sale, so there is no relation to draw.
model InstagramDailyStat {
  id                String   @id @default(cuid())
  igUserId          String   @map("ig_user_id")
  username          String?
  date              DateTime @db.Date
  reach             Int      @default(0)
  views             Int      @default(0)
  totalInteractions Int      @default(0) @map("total_interactions")
  accountsEngaged   Int      @default(0) @map("accounts_engaged")
  likes             Int      @default(0)
  comments          Int      @default(0)
  saves             Int      @default(0)
  shares            Int      @default(0)
  replies           Int      @default(0)
  reposts           Int      @default(0)
  profileLinksTaps  Int      @default(0) @map("profile_links_taps")
  follows           Int      @default(0)
  unfollows         Int      @default(0)
  followsNet        Int      @default(0) @map("follows_net")
  // Untouched payload as received. Lets us backfill a metric we don't have a
  // column for yet without re-running the Make scenario.
  raw               Json
  syncedAt          DateTime @default(now()) @map("synced_at")

  @@unique([igUserId, date])
  @@index([date])
  @@map("instagram_daily_stats")
}

enum CostKind {
  MONTHLY
  ONE_OFF
}

// Operating costs of the account, typed in by hand — there is no billing
// integration to sync them from. One row per line item, not per payment: the
// month range says when it applies, so a recurring cost never needs 12 rows.
model Cost {
  id       String   @id @default(cuid())
  name     String   @unique
  category String
  amount   Decimal  @db.Decimal(12, 2)
  kind     CostKind @default(MONTHLY)
  // First and last month the cost applies, always the 1st of the month.
  // A null endMonth means it is still running.
  startMonth DateTime  @map("start_month") @db.Date
  endMonth   DateTime? @map("end_month") @db.Date
  // Marks a cost with a variable part we don't have a number for (a commission,
  // for example). The totals stay fixed-only and the page says so, instead of
  // quietly reporting an incomplete figure as if it were the whole cost.
  hasVariable Boolean @default(false) @map("has_variable")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("costs")
}

enum DeliveryKind {
  ARTE
  VIDEO
  MARCO
}

// Design output delivered to the client. Unrelated to ad spend and to sales on
// purpose: nothing here is attributed to a campaign or a ticket.
model DesignDelivery {
  id String @id @default(cuid())
  /// Stable natural key for the seed to upsert on ("artes-2026-06"). A compound
  /// unique on (label, month) can't work here: month is null for milestones and
  /// Postgres/Prisma won't match null in a unique lookup.
  key   String       @unique
  label String
  kind  DeliveryKind
  /// Month the batch belongs to (1st of the month). Null for one-off milestones
  /// such as the website or the logo restyle, which don't belong to a count.
  month DateTime? @db.Date
  /// How many pieces. Null for milestones, which are a single delivery.
  quantity  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([month])
  @@map("design_deliveries")
}

// Social selling routine, typed in by hand: these are the cadences the operator
// works to, not numbers any API reports. Stored as a range because that is how
// the work is actually run — "30 a 60 abordagens por dia", never a single value.
model SocialSellingMetric {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  minValue Int    @map("min_value")
  maxValue Int    @map("max_value")
  /// What is being counted ("abordagens", "follows", "leads").
  unit String
  /// When it applies ("por dia", "na base"). Empty for a plain count.
  cadence   String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_selling_metrics")
}

enum NoteTone {
  ALERTA
  NEUTRO
  POSITIVO
}

// Qualitative field notes from the social selling operation — what the numbers
// alone don't say (lead quality, for instance).
model SocialSellingNote {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  body      String
  tone      NoteTone @default(NEUTRO)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_selling_notes")
}
